export CROSS_COMPILE=1
export CLANG=1

# edit these if need be
WIN32_REDIST_DIR="C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Redist\MSVC\14.44.35112\onecore\arm"
WIN_UCRT_REDIST_DIR="C:\Program Files (x86)\Windows Kits\10\Redist\10.0.18362.0\ucrt\DLLs\arm"

LDFLAGS="$LDFLAGS -luuid -v"

ac_add_options --target=armv7-w64-mingw32
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-armv7-arctic-fox
mk_add_options AUTOCLOBBER=1

ac_add_options --with-branding=browser/branding/arcticfox
ac_add_options --disable-jit
ac_add_options --disable-crashreporter
ac_add_options --disable-maintenance-service
ac_add_options --disable-sandbox
ac_add_options --disable-updater
ac_add_options --disable-webrtc
ac_add_options --enable-application=browser
ac_add_options --enable-optimize
ac_add_options --enable-strip

# ac_add_options --disable-nss
ac_add_options --disable-accessibility
ac_add_options --disable-nspr-build
ac_add_options --enable-system-ffi
ac_add_options --enable-system-pixman
ac_add_options --with-system-bz2
ac_add_options --with-system-icu
ac_add_options --with-system-zlib

mk_add_options MOZ_MAKE_FLAGS="-j4"

if test -n "$MOZ_BUILD_APP" ; then
  HOST_CC=$CC
  HOST_CXX=$CXX

  NATIVE_CPU=`$topsrcdir/build/autoconf/config.guess | cut -f1 -d-`

  CC="armv7-w64-mingw32-clang -no-integrated-as"
  CXX="armv7-w64-mingw32-clang++ -no-integrated-as"

  RANLIB="armv7-w64-mingw32-ranlib"
  AR="armv7-w64-mingw32-ar"
  AS=$CC
  STRIP="armv7-w64-mingw32-strip"
  OTOOL="otool"
  # LD="armv7-w64-mingw32-ld"

  CFLAGS="$CFLAGS -no-integrated-as"
  CXXFLAGS="$CXXFLAGS -no-integrated-as"
  ASFLAGS="$ASFLAGS -no-integrated-as"

  LDFLAGS="$LDFLAGS -luuid -v"

  export CROSS_COMPILE=1
  
  # make sure to add LD to the export list if you uncomment said variable
  export CC CXX HOST_CC HOST_CXX RANLIB AR AS STRIP OTOOL CFLAGS CXXFLAGS ASFLAGS LDFLAGS
  
  
fi
